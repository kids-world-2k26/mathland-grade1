{
  "Chào bé nha! Hôm nay cùng cô khám phá vương quốc toán học nghen!": "audio/tts/f2829a6401f9d9cb7354dc7dc2422352.mp3",
  "Bé ơi, chọn một hòn đảo kỳ diệu để tụi mình cùng chơi nào!": "audio/tts/bb3f1a95834643d845f9a045c8031cac.mp3",
  "Cùng đếm số và rinh thật nhiều ngôi sao lấp lánh nha bé!": "audio/tts/8f5198b8f87eb8c9bb13f2d4668b07a9.mp3",
  "Hu-hú! Tớ là Cú Vàng Pip đây! Tớ rất thích học toán cùng bé!": "audio/tts/8775125bf3fbf1d7002872f004e28129.mp3",
  "Bấm vào chiếc loa bất cứ lúc nào để nghe cô đọc câu hỏi to rõ nha bé!": "audio/tts/4c7ed105eb1a3afe6ee0a1fc38573957.mp3",
  "Hôm nay bé làm bài rất là tuyệt vời đó nghen!": "audio/tts/0c2c7578862c57db730dd54cd2d99e59.mp3",
  "Đúng rồi nè! Bé tính nhanh như chớp luôn ta ơi!": "audio/tts/569dbbf74b1e9bf5420bb06e083bbade.mp3",
  "Chính xác một trăm phần trăm luôn! Bé cừ ghê!": "audio/tts/bed0b09e1510add80bffd0d1822a8890.mp3",
  "Tuyệt vời quá chừng luôn bé ơi! Quá đỉnh!": "audio/tts/512fa9d05be86864e9b867a674a56c82.mp3",
  "Đúng y chóc luôn! Bé giỏi quá trời quá đất nè!": "audio/tts/a077fbb012e4af8047656bb6eaad2b06.mp3",
  "Hay dữ dằn luôn bé ơi! Điểm mười xuất sắc cho bé nha!": "audio/tts/1a1b6145c6a1f98384cb8cf73898f062.mp3",
  "Hoan hô bé! Trả lời trúng phóc luôn rồi nè!": "audio/tts/03cf350162de3de73a1a8e5d54c98581.mp3",
  "Bé thông minh sáng dạ quá, cô khen bé nhiều nha!": "audio/tts/0e68177e224503df6819d0cc768eadd6.mp3",
  "Ôi chu choa, bé làm đúng nữa rồi nè, giỏi ghê chưa!": "audio/tts/cf7f0b843ea88620f7bfa8851224fb2e.mp3",
  "Chính xác rồi nè! Bé làm cô tự hào quá đi!": "audio/tts/3352db35a962741d25e0e1ce543c657a.mp3",
  "Quá đã luôn bé ơi! Làm đúng bon không sai một ly nào hết!": "audio/tts/d0ef6d2049cc601c98a561ad1cd47a65.mp3",
  "Giỏi quá xá là giỏi luôn bé ơi! Cứ thế mà phát huy nghen!": "audio/tts/6ea949878764efba3b7afd8ab3266f86.mp3",
  "Bé đúng là nhà thông thái nhí của cô rồi nè!": "audio/tts/0ef3c5eef5748a6bf9fd5067dbf367b7.mp3",
  "Chuẩn không cần chỉnh luôn bé ơi! Tuyệt cú mèo!": "audio/tts/3292af57979b75bca5ce9f171b192738.mp3",
  "Bingo! Đúng nữa rồi! Bé học giỏi dữ dội luôn!": "audio/tts/301b8cff9ae9ca6f79ea14cbf2f212c2.mp3",
  "Bé giải toán siêu đẳng ghê ta ơi! Tiếp tục nào!": "audio/tts/ac86d196e00582ffe7cf89c76578a0db.mp3",
  "Đúng rồi nha! Bé trả lời vừa nhanh vừa chính xác luôn đó!": "audio/tts/81082f9efdf485f81fac898ec73c88d6.mp3",
  "Thật là xuất sắc! Cô tặng bé một tràng pháo tay thật to nè!": "audio/tts/983fac53e3275638832e542df076f1a3.mp3",
  "Bé siêu sao toán học của cô ơi, đúng nữa rồi nè!": "audio/tts/6346ba94da695045b742634ddc89ce13.mp3",
  "Dữ dội quá ta! Bé tính nhẩm đỉnh của chóp luôn!": "audio/tts/40237f8e74ab50203f2fb518ce5fc4b2.mp3",
  "Chính xác tuyệt đối luôn! Bé xứng đáng nhận cúp vàng nha!": "audio/tts/2854cfe41ec01f76fe6ec256acde2f50.mp3",
  "Mười điểm về chỗ nha bé ơi! Làm đúng quá chừng luôn!": "audio/tts/611b59893b97427ba37b228d2206d206.mp3",
  "Hổng chê vào đâu được luôn! Bé thông minh số một nè!": "audio/tts/5d105e70fbe9000952ba8793c7c2e452.mp3",
  "Đúng rồi nè cưng! Bé làm bài cẩn thận và giỏi dữ ta!": "audio/tts/57bf4aa8b7bd9951dbb91b4ee3f817b6.mp3",
  "Tuyệt đỉnh luôn bé ơi! Cô mê cách bé làm toán quá đi à!": "audio/tts/e9bf9b9339f4a3e35e5999c5b0b55991.mp3",
  "Trúng phóc luôn rồi! Bé thông minh như vậy là cô vui lắm đó!": "audio/tts/44a29023272e5a88067e0f4e6a1752b0.mp3",
  "Hay quá xá luôn bé ơi! Bé thông minh tài ba quá nè!": "audio/tts/e7d3bb0849e6172800e03ae37a06571e.mp3",
  "Đúng bon luôn nè bé! Giỏi giang hết phần thiên hạ luôn!": "audio/tts/5831ec8d89f5166c876b462f4b586a77.mp3",
  "Quá cừ khôi luôn! Bé làm cô vỗ tay không ngớt luôn đó!": "audio/tts/bbdbaa805debc62d1a0fb130f9933716.mp3",
  "Gần đúng rồi nè bé ơi! Bình tĩnh nhìn kỹ lại chút xíu nha!": "audio/tts/1381aa987a70cdee5411ddbf3958c0a6.mp3",
  "Úi chà! Không sao đâu bé, mình cùng thử lại nghen!": "audio/tts/ee37f3cee7f59c4a36c2b4e3a084905f.mp3",
  "Cố lên nha bé! Đếm chậm từng cái một xem sao nè!": "audio/tts/392980cccaed817a534749df6715d38e.mp3",
  "Bé làm được mà! Thử lại một lần nữa là trúng liền nè!": "audio/tts/c5faf8f4de8acceb10ec4b6881834177.mp3",
  "Hoan hô! Bé đã hoàn thành bài tập xuất sắc dữ luôn! Rinh 3 ngôi sao nghen!": "audio/tts/d9d4f29fb386185af7d67e339777ac83.mp3",
  "Chúc mừng bé nha! Mở quà xem nhãn dán mới toanh nè!": "audio/tts/ce2d3cc5fa15d7388e6a4a4895ea7c45.mp3",
  "Tuyệt vời quá bé ơi! Càng chơi bé càng thông minh xuất sắc!": "audio/tts/0cd79be031669f542b438c3907775e44.mp3",
  "Có bao nhiêu chấm tròn trong Khung 10 ô?": "audio/tts/956b49983498c3ef7d10ea1af2180c09.mp3",
  "Bé hãy đếm xem có bao nhiêu hình?": "audio/tts/ff1b1a813d188b13c63e234bdbb79651.mp3",
  "Bạn Cá Sấu Allie nên há miệng ngoạm bên nào?": "audio/tts/178bcfe90debc98ef1da8b700fce0722.mp3",
  "Gộp các phần lại! Số ở trên cùng là bao nhiêu?": "audio/tts/0b4e68738bc660f5c94fedb7139d8379.mp3",
  "Hình nào tiếp theo trên toa tàu quy luật?": "audio/tts/5a9d3f650b43cfc65e8021dce3d75a0f.mp3",
  "Đồng hồ đang chỉ mấy giờ?": "audio/tts/a6c68c92c4ab742a35219123c140477f.mp3",
  "Cây bút chì nào dài hơn?": "audio/tts/6988746ecceda32f683ae35faf83231d.mp3",
  "Cây bút chì nào ngắn hơn?": "audio/tts/1c8a8e896a7eaa42fd285ebb1fe544cf.mp3",
  "Đồ vật này có dạng khối gì?": "audio/tts/3461bc6133174d60e128fd1f1aaa107e.mp3",
  "Chuẩn luôn bé ơi! Bé chọn đúng rồi này!": "audio/tts/195df0d642399b6e354f50c55f9a539c.mp3",
  "Đúng rồi nè bé! Giỏi quá đi mất!": "audio/tts/36305b1b4355e6870646ae06bc7bd754.mp3",
  "Ồ, chính xác luôn! bé làm tốt lắm nha!": "audio/tts/3eb64e7fcc28189ded4c77f59255397f.mp3",
  "Đúng y chóc luôn bé ơi! Cô thưởng cho một vỗ tay nha!": "audio/tts/b34cff174ffd3c72de3b290748c25f13.mp3",
  "Hay quá bé ơi, đúng ngay đáp án rồi!": "audio/tts/95fbfc3a5b2f7068905b0e3d1acd9371.mp3",
  "Bé làm đúng rồi nè, cẩn thận từng chút một luôn!": "audio/tts/eced618a6f00225d949173577b1fee4d.mp3",
  "Chính xác rồi! bé nhìn phát biết ngay luôn!": "audio/tts/eb174cade23fd95f24f6f6cd555ed657.mp3",
  "Chuẩn không cần chỉnh luôn bé! Giỏi ghê!": "audio/tts/d908428a12a0a37e571776ea9a74a3e4.mp3",
  "Bé suy luận thông minh ghê chưa!": "audio/tts/4cabbb319dd826c029433decfbe14021.mp3",
  "Đúng rồi nè! bé tinh mắt quá đi!": "audio/tts/61929c572ca12fcccf3e4b6fbaf540d0.mp3",
  "Chính xác! Hôm nay bé làm bài phong độ quá ta!": "audio/tts/72fd3726acd6b727f1c7e430f1a6318a.mp3",
